#!/usr/bin/env python3
import hashlib
import json
import os
from pathlib import Path
import sys

owner, name = sys.argv[sys.argv.index("inspect") + 1].removeprefix("@").split("/")
source, = (Path("plugins") / owner / "skills").glob("*/" + name)
assert "CLAWHUB_SKILL_TOKEN" not in os.environ
files = [{"path": p.relative_to(source).as_posix(), "sha256": hashlib.sha256(p.read_bytes()).hexdigest()}
         for p in source.rglob("*") if p.is_file() and p.name != ".DS_Store" and p.suffix != ".pyc"]
files.append({"path": "skill-card.md", "sha256": "a" * 64})
if os.environ.get("PETERFLOW_TEST_EXTRA_FILE") == name:
    files.append({"path": "unexpected.md", "sha256": "b" * 64})
print(json.dumps({"owner": {"handle": owner}, "skill": {"slug": name}, "latestVersion": {"version": "1.0.0"},
                  "version": {"version": "1.0.0", "files": files}}))
